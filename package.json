{
  "name": "componentbook",
  "version": "0.1.0",
  "description": "Generate MDX documentation for your components",
  "keywords": [
    "cli",
    "componentbook",
    "design-system",
    "docs",
    "documentation",
    "docusaurus",
    "fumadocs",
    "mdx",
    "react",
    "starlight"
  ],
  "homepage": "https://github.com/bangseongbeom/componentbook",
  "bugs": "https://github.com/bangseongbeom/componentbook/issues",
  "license": "MIT",
  "author": "방성범 (Bang Seongbeom) <bangseongbeom@gmail.com>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/bangseongbeom/componentbook.git"
  },
  "bin": "dist/bin/componentbook.js",
  "type": "module",
  "exports": {
    ".": "./dist/index.js",
    "./docusaurus": "./dist/docusaurus/index.js",
    "./fumadocs": "./dist/fumadocs/index.js",
    "./fumadocs/preset.css": "./dist/fumadocs/preset.css",
    "./starlight": "./dist/starlight/index.js"
  },
  "scripts": {
    "fmt": "oxfmt",
    "fmt:check": "oxfmt --check",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "prepack": "tsc && cp src/fumadocs/preset.css dist/fumadocs/ && cp src/docusaurus/styles.css dist/docusaurus/ && cp src/starlight/*.astro dist/starlight/",
    "test": "node --test",
    "types:check": "tsc --noEmit"
  },
  "dependencies": {
    "magic-string": "^1.4.5",
    "mdast-util-from-markdown": "^2.1.0",
    "micromark": "^4.0.3",
    "oxc-parser": "^0.158.0",
    "perfect-debounce": "^2.1.0",
    "shiki": "^4.5.0",
    "typescript": "7.0.2"
  },
  "devDependencies": {
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "fumadocs-ui": "npm:@fumadocs/base-ui@^16.19.3",
    "oxfmt": "^0.73.0",
    "oxlint": "^1.90.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "tailwindcss": "^4.3.3"
  },
  "peerDependencies": {
    "@astrojs/starlight": ">=0.41.0",
    "astro": "^7.0.0",
    "fumadocs-ui": "npm:@fumadocs/base-ui@^16.0.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "tailwindcss": "^4.0.0"
  },
  "peerDependenciesMeta": {
    "@astrojs/starlight": {
      "optional": true
    },
    "astro": {
      "optional": true
    },
    "fumadocs-ui": {
      "optional": true
    },
    "react": {
      "optional": true
    },
    "react-dom": {
      "optional": true
    },
    "tailwindcss": {
      "optional": true
    }
  },
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "12.14.0",
      "onFail": "download"
    }
  },
  "engines": {
    "node": ">=24.14"
  },
  "packageManager": "pnpm@12.14.0"
}
